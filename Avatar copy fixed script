local function getTargetPlayer(nameText)
	nameText = nameText:lower():gsub("%s+", "")
	for _, p in pairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #nameText) == nameText or p.DisplayName:lower():sub(1, #nameText) == nameText then
			return p
		end
	end
	return nil
end

local function copyFullCharacter(targetChar)
	local myChar = LocalPlayer.Character
	if not myChar or not targetChar or not myChar:FindFirstChild("Humanoid") then return end

	-- 1. Clear my character's current accessories & clothing
	for _, item in pairs(myChar:GetChildren()) do
		if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
			item:Destroy()
		end
	end

	task.wait(0.1)

	-- 2. Clone Shirts, Pants & Graphics
	for _, item in pairs(targetChar:GetChildren()) do
		if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
			item:Clone().Parent = myChar
		end
	end

	-- 3. Clone Hair, Mesh Accessories & Layered Clothing with Attachment Re-welding
	for _, item in pairs(targetChar:GetChildren()) do
		if item:IsA("Accessory") then
			local accClone = item:Clone()
			accClone.Parent = myChar
			
			local handle = accClone:FindFirstChild("Handle")
			if handle then
				-- Find matching body part attachment in local character
				local att = handle:FindFirstChildOfClass("Attachment")
				if att then
					for _, part in pairs(myChar:GetChildren()) do
						if part:IsA("BasePart") and part:FindFirstChild(att.Name) then
							-- Create a new weld constraint
							local weld = Instance.new("WeldConstraint")
							weld.Part0 = handle
							weld.Part1 = part
							weld.Parent = handle
							handle.CFrame = part:FindFirstChild(att.Name).WorldCFrame
							break
						end
					end
				end
			end
			
			myChar.Humanoid:AddAccessory(accClone)
		end
	end
end

CopyBtn.MouseButton1Click:Connect(function()
	local target = getTargetPlayer(TextBox.Text)
	if target and target.Character then
		TextBox.Text = target.Name
		copyFullCharacter(target.Character)
	else
		TextBox.Text = "Player Not Found!"
	end
end)

ResetBtn.MouseButton1Click:Connect(function()
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
		local success, desc = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
		end)
		if success and desc then
			LocalPlayer.Character.Humanoid:ApplyDescription(desc)
		end
	end
end)
